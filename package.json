{
  "name": "micropython-ota-updater",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "test-station run --config ./test-station.config.mjs",
    "test:station": "test-station run --config ./test-station.config.mjs",
    "test:ci": "test-station run --config ./test-station.config.mjs",
    "test:fast": "test-station run --config ./test-station.config.mjs --no-coverage",
    "test:coverage": "test-station run --config ./test-station.config.mjs --coverage",
    "ci:publish:test-station": "node ./scripts/ci/publish-test-station-report.mjs"
  },
  "devDependencies": {
    "@test-station/cli": "0.2.76"
  }
}
